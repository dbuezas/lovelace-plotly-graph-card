{
  "name": "plotly-graph-card",
  "version": "to-be-set-on-release",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "(node ./script/hot-reload.mjs & esbuild src/plotly-graph-card.ts --servedir=dist --outdir=dist --bundle --splitting --format=esm --loader:.css=empty --inject:src/process-shim.ts --sourcemap=inline)",
    "build": "rm -rf dist && esbuild src/plotly-graph-card.ts --outdir=dist --bundle --minify --splitting --format=esm --chunk-names=[name]-[hash] --loader:.css=empty --inject:src/process-shim.ts",
    "tsc": "tsc",
    "test": "jest",
    "test:cache": "jest --runInBand src/cache/Cache.test.ts src/cache/date-ranges.test.ts src/cache/observed-range.test.ts src/parse-config/cache-retention.test.ts",
    "test:statistics": "jest --runInBand src/cache/fetch-statistics.test.ts src/cache/statistics-cache.test.ts src/cache/date-ranges.test.ts src/parse-config/parse-config.test.ts",
    "test:browser": "node script/test-plotly-browser.mjs",
    "test:autorange": "node script/test-autorange.mjs",
    "test:loading": "node script/test-loading-state.mjs",
    "test:resize": "node script/test-resize.mjs",
    "test:card-lifecycle": "node script/test-card-lifecycle.mjs",
    "test:touch": "node script/test-touch-gestures.mjs",
    "test:split": "node script/test-split-build.mjs",
    "test:watch": "jest --watchAll",
    "version": "npm run build && git add .",
    "npm-upgrade": "npx npm-upgrade"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.191",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.5.4",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "ws": "^8.12.0"
  },
  "dependencies": {
    "assert": "^2.1.0",
    "binary-search-bounds": "^2.0.5",
    "buffer": "^6.0.3",
    "custom-card-helpers": "^1.9.0",
    "date-fns": "^4.4.0",
    "deepmerge": "^4.2.2",
    "fourier-transform": "^1.1.2",
    "lodash": "^4.17.21",
    "ml-fft": "^1.3.5",
    "ml-regression-exponential": "^2.1.0",
    "ml-regression-logarithmic": "github:DoubleCorner/regression-logarithmic",
    "ml-regression-polynomial": "^2.2.0",
    "ml-regression-power": "^2.0.0",
    "ml-regression-robust-polynomial": "^3.0.0",
    "ml-regression-simple-linear": "^2.0.3",
    "ml-regression-theil-sen": "^2.0.0",
    "ndarray": "^1.0.19",
    "ndarray-fft": "^1.0.3",
    "plotly.js": "4.1.2",
    "process": "^0.11.10",
    "propose": "^0.0.5",
    "stream": "npm:stream-browserify@^3.0.0"
  },
  "overrides": {
    "static-eval": "^2.1.1",
    "minimist": "^1.2.8",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
