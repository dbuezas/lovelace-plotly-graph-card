    "test:autorange": "node script/test-autorange.mjs",
    "test:loading": "node script/test-loading-state.mjs",
    "test:resize": "node script/test-resize.mjs",
    "test:card-lifecycle": "node script/test-card-lifecycle.mjs",
    "test:touch": "node script/test-touch-gestures.mjs",
